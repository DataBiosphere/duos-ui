# This file is a template for local development environment variables. Copy it to `.env` and fill in the values
# for your local setup. The `.env` file is git-ignored; never commit real secrets. In Kubernetes, these are injected
# by the Deployment process.

HOST=local.dsde-dev.broadinstitute.org
HTTPS=true
SSL_CRT_FILE=server.crt
SSL_KEY_FILE=server.key

# BFF — local development environment variables
# --- Session ---------------------------------------------------------------
# Any 32+ character string for local dev; from GSM `duos-session-secret` in k8s,
DUOS_SESSION_SECRET=change-me-to-a-random-32-plus-char-string

# --- Database (consent Postgres) -------------------------------------------
# Defaults to the bundled `db` compose service (docker compose --profile local-db).
# To point at a local `consent` compose stack's Postgres instead (its `sqlproxy`
# service publishes 5432 on the host), set:
#   DUOS_DB_HOST=host.docker.internal
#   DUOS_DB_USER/PASSWORD/NAME matching that stack's sqlproxy credentials
# In that mode, run this repo's compose WITHOUT --profile local-db so the
# bundled `db` service (which would otherwise also claim host port 5432) is
# skipped. See docker-compose.yaml and DEVNOTES.md for details.
DUOS_DB_HOST=
DUOS_DB_NAME=
DUOS_DB_PORT=
DUOS_DB_USER=
DUOS_DB_PASSWORD=

# --- Google OAuth ----------------------------------------------------------
DUOS_GOOGLE_OAUTH_CLIENT_ID=
DUOS_GOOGLE_OAUTH_CLIENT_SECRET=
DUOS_GOOGLE_ISSUER_URL=

# --- Azure B2C OAuth -------------------------------------------------------
DUOS_AZURE_CLIENT_ID=
DUOS_AZURE_CLIENT_SECRET=
# Dev B2C discovery URL
DUOS_AZURE_ISSUER_URL=

# --- OAuth flow ------------------------------------------------------------
DUOS_OAUTH_REDIRECT_URI=http://local.dsde-dev.broadinstitute.org:3000/auth/callback

# --- Downstream API --------------------------------------------------------
DUOS_API_URL=https://consent.dsde-dev.broadinstitute.org
