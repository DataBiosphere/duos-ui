# This file is a template for local development environment variables. Copy it to `.env.local` and fill in the
# values for your local setup — everything in this repo (pnpm start:server, both docker compose modes) reads
# `.env.local`, never `.env`. The `.env.local` file is git-ignored; never commit real secrets. In Kubernetes,
# these are injected by the Deployment process.

HOST=local.dsde-dev.broadinstitute.org
HTTPS=true
SSL_CRT_FILE=server.crt
SSL_KEY_FILE=server.key

# BFF — local development environment variables
# --- Session ---------------------------------------------------------------
# Any 32+ character string for local dev; from GSM `duos-session-secret` in k8s,
DUOS_SESSION_SECRET=change-me-to-a-random-32-plus-char-string

# --- Database (consent Postgres) -------------------------------------------
# DUOS_DB_HOST is not set here — it's supplied by whichever docker-compose
# overlay file you run with (docker-compose.override.yaml sets it to the
# bundled `db` service; docker-compose.consent.yaml defaults it to
# host.docker.internal, for pointing at a local `consent` compose stack's
# Postgres instead). Only set it here to override that overlay default.
# DUOS_DB_USER/PASSWORD/NAME must match whichever Postgres is actually in
# play — see docker-compose.yaml and DEVNOTES.md for details.
DUOS_DB_NAME=
DUOS_DB_PORT=
DUOS_DB_USER=
DUOS_DB_PASSWORD=

# --- Google OAuth ----------------------------------------------------------
DUOS_GOOGLE_OAUTH_CLIENT_ID=
DUOS_GOOGLE_OAUTH_CLIENT_SECRET=
DUOS_GOOGLE_ISSUER_URL=

# --- Azure B2C OAuth -------------------------------------------------------
DUOS_AZURE_CLIENT_ID=
DUOS_AZURE_CLIENT_SECRET=
# Dev B2C discovery URL
DUOS_AZURE_ISSUER_URL=

# --- OAuth flow ------------------------------------------------------------
DUOS_OAUTH_REDIRECT_URI=http://local.dsde-dev.broadinstitute.org:3000/auth/callback

# --- Downstream API --------------------------------------------------------
DUOS_API_URL=https://consent.dsde-dev.broadinstitute.org
