# Copy to .env.local (gitignored); never commit secrets.
# pnpm start:server loads it; Compose needs --env-file .env.local.
# For pnpm run serve and E2E, export variables first (TESTING.md).
# Kubernetes injects variables; nothing reads .env.

HOST=local.dsde-dev.broadinstitute.org
HTTPS=true
SSL_CRT_FILE=server.crt
SSL_KEY_FILE=server.key

# BFF — local development environment variables
# --- Session ---------------------------------------------------------------
# Any 32+ character string for local dev; from GSM `duos-session-secret` in k8s,
DUOS_SESSION_SECRET=change-me-to-a-random-32-plus-char-string

# --- Database (consent Postgres) -------------------------------------------
# Compose supplies DUOS_DB_HOST: db in the default overlay, host.docker.internal
# in docker-compose.consent.yaml. Host-run servers need localhost (or another
# reachable host) and the published port; db resolves only inside Docker.
# Match NAME/USER/PASSWORD to the database. render-configs.sh --write_env true
# fills unset USER/PASSWORD from the dev cluster. See DEVNOTES.md.
# TLS defaults on. Set DUOS_DB_SSL=false for local Postgres or Cloud SQL Proxy;
# both Compose overlays already do this.
# DUOS_DB_SSL=false
DUOS_DB_NAME=consent
DUOS_DB_PORT=
DUOS_DB_USER=
DUOS_DB_PASSWORD=

# --- Azure B2C OAuth --------------------------------------------------------
# The single BFF OIDC client — B2C federates Google and Microsoft internally,
# so no Google OAuth client credentials are used in v2.
# The value below is the hand-created dev app registration (not secret).
DUOS_AZURE_CLIENT_ID=a0e99acd-7b8d-400d-a1d3-60e497495806
# Populated automatically by `./scripts/render-configs.sh --write_env true`
# (requires the non-split VPN, like the rest of that script). To fetch it
# manually instead, read it from the dev cluster and BASE64-DECODE it —
# kubectl's .data values are base64-wrapped, and pasting the wrapped value
# here yields AADB2C90081 ("client_secret does not match") at the token
# exchange. The real value is a 40-char string like Xxx8Q~…:
#   kubectl get secret duos-azure-client-secret -n terra-dev \
#     -o jsonpath='{.data.azure-client-secret}' | base64 --decode
DUOS_AZURE_CLIENT_SECRET=
# Dev B2C discovery URL
DUOS_AZURE_ISSUER_URL=

# --- OAuth flow ------------------------------------------------------------
# Both variants are registered in B2C: keep the :3000 port when running the
# dev server (pnpm start / pnpm run start:server); use
# https://local.dsde-dev.broadinstitute.org/auth/callback (no port) when
# running under docker compose, which is closer to how the app runs in k8s.
DUOS_OAUTH_REDIRECT_URI=http://local.dsde-dev.broadinstitute.org:3000/auth/callback
# Must exactly match a post-logout URI registered with B2C.
DUOS_POST_LOGOUT_REDIRECT_URI=http://local.dsde-dev.broadinstitute.org:3000/post-logout

# --- Downstream API --------------------------------------------------------
# Public endpoints use these upstreams independently of BFF cutover.
# An unset value makes the corresponding public route answer 503 (never the SPA
# page, which the client would read as success); malformed values fail startup.
DUOS_API_URL=https://consent.dsde-dev.broadinstitute.org
# ECM (externalcreds), proxied at /ecm-api for RAS/eRA Commons linking.
# Optional: when unset, the BFF boots without the ECM proxy and logs a warning.
DUOS_ECM_URL=https://externalcreds.dsde-dev.broadinstitute.org
# TDR, proxied at /tdr-api for snapshot enumeration on dataset pages.
# Optional, same behavior as DUOS_ECM_URL when unset.
DUOS_TDR_URL=https://jade.datarepo-dev.broadinstitute.org
# Bard (Mixpanel gateway), proxied at /bard-api for identified usage metrics
# and at /public/metrics/event for anonymous ones.
# Optional, same behavior as DUOS_ECM_URL when unset.
DUOS_BARD_URL=https://terra-bard-dev.appspot.com

# --- Content Security Policy ------------------------------------------------
# false enforces the policy. Every deployed environment sets false
# (terra-helmfile#6500), and the httpd proxy passes the app's policy through
# unchanged (terra-helmfile#6497). When unset, the server defaults to
# report-only. Set true to only report violations while you debug the policy.
# `render-configs.sh --write_env true` writes false.
# The allowlist comes from config.json; see docs/plans/bff_adrs/ADR-013-content-security-policy.md.
# To see the policy the browser receives:
#   curl -sI https://<host>/ | grep -i content-security-policy
DUOS_CSP_REPORT_ONLY=false

# --- Server transport -------------------------------------------------------
# Whether this process terminates TLS itself. Unset means the historical rule:
# the local dev server reads server.key/server.crt from the project root, and
# every other environment takes plain HTTP behind the proxy that terminates TLS
# for it. Set it true for a production-mode server that must speak HTTPS on its
# own — the E2E harness does, because the session cookie is Secure (`pnpm run
# serve` sets it). The certificate files must exist wherever it is true.
# DUOS_SERVER_HTTPS=true
#
# Whether to send Strict-Transport-Security. Unset means on outside development.
# `pnpm run serve` defaults it off: the harness runs the production build on the
# hostname a developer browses, and a year-long pin there is what the guard in
# server/src/security/headers.ts exists to prevent. CI sets it true.
# DUOS_HSTS=false

# --- Auth rate limiting ----------------------------------------------------
# Per-IP flood control on POST /auth/login and GET /auth/callback, in requests
# per minute. Both are optional: unset means the shipped defaults (30 and 60).
# Set them to tighten or relax the limits from measured traffic without a code
# release — many users share one institutional NAT egress IP, so a per-IP
# bucket is really a per-campus bucket. A value that is not a positive integer
# fails at startup. See server/src/security/rateLimit.ts.
# DUOS_RATE_LIMIT_LOGIN_MAX=30
# DUOS_RATE_LIMIT_CALLBACK_MAX=60

# --- E2E role fixture (dev / BEE only) --------------------------------------
# Requires config.json env=dev, bffEnabled=true and a session DB; otherwise boot fails.
# EMAILS: comma-separated *.iam.gserviceaccount.com client_email values, never keys.
# DUOS_TEST_SIGNIN_ENABLED=true
# DUOS_TEST_SIGNIN_EMAILS=admin@project.iam.gserviceaccount.com,chair@project.iam.gserviceaccount.com,member@project.iam.gserviceaccount.com,researcher@project.iam.gserviceaccount.com,so@project.iam.gserviceaccount.com
# DUOS_RATE_LIMIT_TEST_SIGNIN_MAX=300
