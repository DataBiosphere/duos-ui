    "eslint-plugin-react-refresh": "0.4.19",
    "globals": "16.0.0",
    "google-auth-library": "9.15.1",
    "history": "5.3.0",
    "prop-types": "15.8.1",
    "rollup-plugin-visualizer": "5.14.0",
