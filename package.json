{
  "name": "duos-ui",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "analyze": "VISUALIZER_PLUGIN=true vite build",
    "start": "vite",
    "start:server": "tsx watch --env-file=.env.local server/src/index.ts",
    "build": "vite build && node scripts/write-vite-config-json.mjs && pnpm --filter duos-server build",
    "preview": "vite preview",
    "serve": "vite preview --port 3000",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint && eslint .",
    "lint:fix": "oxlint --fix && eslint . --fix",
    "type-check": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:browser:coverage": "vitest run --coverage --config vitest.browser.config.ts"
  },
  "dependencies": {
    "@databiosphere/bard-client": "0.1.0",
    "@mui/icons-material": "9.1.1",
    "@mui/material": "9.0.1",
    "@mui/system": "9.2.0",
    "@mui/x-data-grid": "9.10.0",
    "@mui/x-date-pickers": "9.2.0",
    "@tanstack/react-query": "5.101.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "dayjs": "1.11.21",
    "dompurify": "3.4.12",
    "oidc-client-ts": "3.5.0",
    "query-string": "9.4.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-dropzone": "17.0.0",
    "react-google-charts": "5.2.1",
    "react-markdown": "10.1.0",
    "react-modal": "3.16.3",
    "react-paginating": "1.4.0",
    "react-router-dom": "7.18.0",
    "react-select": "5.10.2",
    "react-tooltip": "6.0.8",
    "tss-react": "4.9.21",
    "uuid": "14.0.1"
  },
  "devDependencies": {
    "@emotion/styled": "11.14.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/react-modal": "3.16.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "@playwright/test": "1.61.1",
    "eslint": "10.6.0",
    "google-auth-library": "10.9.0",
    "history": "5.3.0",
    "jiti": "2.7.0",
    "jsdom": "29.1.1",
    "open": "11.0.0",
    "oxlint": "1.74.0",
    "playwright": "^1.61.1",
    "prop-types": "15.8.1",
    "rollup-plugin-visualizer": "7.0.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.0",
    "vitest": "4.1.10"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "engines": {
    "node": ">=26.4.0 <27"
  },
  "type": "module"
}
