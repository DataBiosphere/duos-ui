    "eslint": "9.37.0",
    "eslint-plugin-cypress": "5.1.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.22",
    "globals": "16.4.0",
    "google-auth-library": "10.4.0",
    "history": "5.3.0",
