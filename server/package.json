{
  "name": "duos-server",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
