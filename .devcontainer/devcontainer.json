{
    "name": "Node.js",
    "image": "mcr.microsoft.com/vscode/devcontainers/javascript-node:26-trixie",
    "postCreateCommand": "./scripts/setup-devcontainer.sh",
    "remoteUser": "node",
    "customizations": {
        "vscode": {
            "extensions": [
                "anthropic.claude-code",
                "openai.chatgpt",
                "SonarSource.sonarlint-vscode"
            ],
            "settings": {
                "sonarlint.pathToNodeExecutable": "/usr/local/bin/node",
                "sonarlint.ls.javaHome": "/usr/local/sdkman/candidates/java/current",
                "sonarlint.disableTelemetry": true
            }
        }
    },
    "features": {
        "ghcr.io/devcontainers/features/java:1": {
            "version": "25",
            "jdkDistro": "tem"
        },
        "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
            "helm": "none",
            "minikube": "none"
        }
    },
    "initializeCommand": "mkdir -p \"$HOME/.claude\" \"$HOME/.codex\"",
    "mounts": [
        "source=${localEnv:HOME}/.claude,target=/home/node/.claude,type=bind",
        "source=${localEnv:HOME}/.codex,target=/home/node/.codex,type=bind"
    ],
    "containerEnv": {
        "CLAUDE_CONFIG_DIR": "/home/node/.claude",
        "CODEX_HOME": "/home/node/.codex"
    }
}
